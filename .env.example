# MoodMeal Environment Configuration
# Copy this file to .env and fill in your values

# MySQL Database
MOODMEAL_DB_HOST=localhost
MOODMEAL_DB_PORT=3306
MOODMEAL_DB_NAME=moodmeal
MOODMEAL_DB_USER=root
MOODMEAL_DB_PASS=your_password_here

# Kaggle API (alternative to ~/.kaggle/kaggle.json)
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key
