# EmoEating Environment Configuration
# Copy this file to .env and fill in your values

# MySQL Database
MOODMEAL_DB_HOST=localhost
MOODMEAL_DB_PORT=3306
MOODMEAL_DB_NAME=moodmeal
MOODMEAL_DB_USER=root
MOODMEAL_DB_PASS=your_password_here

# Kaggle API (alternative to ~/.kaggle/kaggle.json)
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# Google Places API (New) — required for Nearby Restaurants feature
# At https://console.cloud.google.com/apis/credentials, enable BOTH:
#   • "Places API (New)"   — for restaurant text search
#   • "Geocoding API"      — for manual address → lat/lng lookup (geocode_address())
# Both can share the same API key if issued under the same GCP project.
GOOGLE_PLACES_API_KEY=your_key_here

# Foursquare Places API v3 — NOTE: v3 endpoint returned HTTP 410 Gone (permanently removed).
# Key kept for reference; not used in the active fallback chain.
FOURSQUARE_API_KEY=your_fsq3_key_here

# HERE Geocoding & Search API (free: 1 000 req/day, no credit card needed)
# Sign up at: https://platform.here.com/ → Create project → Generate API key
# Used as fallback when Google Places is unavailable or returns 403.
HERE_API_KEY=your_here_api_key_here

# Optional tuning
RESTAURANT_SEARCH_RADIUS_M=2000
RESTAURANT_MAX_RESULTS=4

# Vietnamese dataset toggle
# true  → app connects to MOODMEAL_VN_DB_NAME schema (Vietnamese food data)
# false → app connects to MOODMEAL_DB_NAME schema (original multi-dataset)
# Requires running: python etl/run_etl.py --datasets vietnamese
USE_VN_DATA=false
MOODMEAL_VN_DB_NAME=moodmeal_vn

# Gemini Live voice check-in — required to enable the live conversation on
# the Emotion page (the primary check-in flow, and one of this project's
# core research contributions). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional overrides (defaults shown):
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_VOICE=Aoede
# GEMINI_WS_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1alpha.GenerativeService.BidiGenerateContentConstrained
# On Streamlit Community Cloud: set GEMINI_API_KEY in the app's Secrets. The
# conversation itself runs client-side (browser WebSocket to Gemini) plus
# one lightweight ephemeral-token mint here — it was never affected by the
# SER RAM issue below, so no extra cloud config is needed for this part.

# Remote SER inference — a FALLBACK, not needed by default. The app runs
# funasr in-process everywhere (including Streamlit Community Cloud) using a
# smaller backbone sized to fit the free tier. Only set this pair if that
# still proves too heavy on your actual Streamlit Cloud quota; it points at a
# deployed copy of server/ (see server/README.md).
# Leave BOTH unset (the default) to keep running funasr in-process.
# SER_REMOTE_URL=https://your-ser-server.example.com
# SER_REMOTE_TOKEN=shared_secret_matching_the_server_SER_SERVER_TOKEN
# SER_REMOTE_TIMEOUT_S=90
