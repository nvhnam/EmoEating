# EmoEating backend configuration — copy to `.env` and fill in.
# `.env` is gitignored; real environment variables override these values.
# Loaded by emoeating.config.load_settings() (searches up from the cwd).

# --- Voice agent provider ---------------------------------------------------
# Which conversational voice provider to use: "openai" or "gemini".
EMOEATING_VOICE_PROVIDER=openai

# OpenAI Realtime (used when EMOEATING_VOICE_PROVIDER=openai)
EMOEATING_OPENAI_API_KEY=
# EMOEATING_OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
# EMOEATING_OPENAI_REALTIME_VOICE=alloy

# Google Gemini Live (used when EMOEATING_VOICE_PROVIDER=gemini)
EMOEATING_GOOGLE_API_KEY=
# EMOEATING_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# EMOEATING_GEMINI_VOICE=Aoede

# --- CORS (the SvelteKit dev origins) ---------------------------------------
EMOEATING_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional: real emotion model + food store (else dev_server uses mocks) --
# EMOEATING_MODEL_PATH=iic/emotion2vec_plus_large
# EMOEATING_STORE_PATH=./foods.sqlite

# --- Optional: images + places (recommendation enrichment) ------------------
# EMOEATING_GOOGLE_IMAGE_API_KEY=
# EMOEATING_GOOGLE_IMAGE_CX=
# EMOEATING_GOOGLE_PLACES_API_KEY=
